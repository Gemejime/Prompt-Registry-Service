# RAG Prompt Registry Service - Environment Configuration (.env.example)
# NOTE: `.env` is for LOCAL DEVELOPMENT ONLY. Only changes to `.env.prod` affect
# `deployments/` (synced into Helm `values.yaml` via `scripts/sync_env_to_deployments.py --sync`).
# Copy this file to `.env` for local development. The control plane server loads `.env`
# automatically at startup (or the file specified by ENV_FILE) without overriding
# variables already exported in the process environment.

# Server Ports & Documentation
HTTP_PORT=8080
GRPC_PORT=9090
OPENAPI_SPEC_PATH=openapi/openapi.yaml

# PostgreSQL 16+ Connection (via PgBouncer in Transaction Pooling Mode - ADR-003)
POSTGRES_DSN=postgres://postgres:postgres@localhost:6432/prompt_registry?sslmode=disable
CONN_EXEC_MODE=simple_protocol
ALLOW_IN_MEMORY_STORE=false
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=2
POSTGRES_AUTO_MIGRATE=true

# Redis 7.2 Cluster / Standalone Configuration (L2 Cache & Pub/Sub Bus - ADR-002)
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_INVALIDATION_CHANNEL=channel:prompt:invalidation

# Authentication, Rate Limiting & Multi-Tenancy
# Set a strong HS256 secret in staging/production (defaults to local dev secret when empty)
JWT_HMAC_SECRET=
JWT_ISSUER=rag-prompt-registry-auth
ADMIN_WRITE_RATE_LIMIT_RPS=50
ADMIN_WRITE_RATE_LIMIT_BURST=100
DEFAULT_TENANT_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# Observability & Logging (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

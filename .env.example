# RAG Prompt Registry Service - Environment Configuration (.env.example)

# Server Ports
HTTP_PORT=8080
GRPC_PORT=50051

# PostgreSQL 16+ Connection (via PgBouncer in Transaction Pooling Mode - ADR-003)
POSTGRES_DSN=postgres://postgres:postgres@localhost:6432/prompt_registry?sslmode=disable
ALLOW_IN_MEMORY_STORE=false
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=2
POSTGRES_AUTO_MIGRATE=true

# Redis 7.2 Cluster / Standalone Configuration (L2 Cache & Pub/Sub Bus - ADR-002)
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_INVALIDATION_CHANNEL=channel:prompt:invalidation

# Rate Limiting & Security
ADMIN_WRITE_RATE_LIMIT_RPS=50
ADMIN_WRITE_RATE_LIMIT_BURST=100
DEFAULT_TENANT_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
LOG_LEVEL=INFO

